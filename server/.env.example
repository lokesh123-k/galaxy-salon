# Galaxy Salon System - Environment Configuration
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit the .env file with real credentials to version control!

# ==================== DATABASE ====================
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/galaxy-salon-system
# For local MongoDB: mongodb://localhost:27017/galaxy-salon-system
MONGODB_DNS=8.8.8.8,8.8.4.4

# ==================== SERVER ====================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# ==================== AUTHENTICATION ====================
JWT_SECRET=change-this-to-a-secure-random-string-in-production-minimum-32-chars
JWT_EXPIRES_IN=7d

# ==================== BUSINESS ====================
BUSINESS_NAME=Galaxy Unisex Saloon & Beauty Academy
BUSINESS_ADDRESS=Your Business Address Here
BUSINESS_PHONE=+91-XXXXXXXXXX
BUSINESS_EMAIL=info@galaxysalon.com

# ==================== WHATSAPP INTEGRATION ====================
# Get these from: https://developers.facebook.com/docs/whatsapp/cloud-api/
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# ==================== EMAIL SERVICE (SMTP) ====================
# Gmail: use App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@galaxysalon.com

# ==================== PAYMENT GATEWAY ====================
# Razorpay credentials from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ==================== THERMAL PRINTER ====================
# Printer network configuration
PRINTER_IP=192.168.1.100
PRINTER_PORT=9100

# ==================== LOGGING & DEBUGGING ====================
LOG_LEVEL=debug
ENABLE_PRODUCTION_LOGGING=false

# ==================== SECURITY ====================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_MAX=200
SESSION_TIMEOUT=60
